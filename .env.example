# EstateHub Environment Variables Configuration Template
# Duplicate this file to .env for local overrides

# Application
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realestate_db
DB_USER=postgres
DB_PASSWORD=root

# Security & JWT
# Minimum 32-character high-entropy secret string
JWT_SECRET=EstateHubSuperSecretKeyForJWTTokenSigning2026SecureKeyWithHighEntropy!
JWT_EXPIRATION_MS=86400000

# Initial Admin Bootstrap
ADMIN_EMAIL=admin@estatehub.com
ADMIN_PASSWORD=AdminSecure2026!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables (for frontend/.env)
VITE_API_BASE_URL=http://localhost:8080/api/v1
